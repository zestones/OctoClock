{
    "name": "@octoclock/browser-ext",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Chrome MV3 extension entry points, browser adapters, and build config.",
    "scripts": {
        "build:popup": "vite build --config vite.config.popup.js",
        "build:background": "vite build --config vite.config.background.js",
        "build:content": "vite build --config vite.config.content.js",
        "build": "rm -rf dist && pnpm run build:popup && pnpm run build:background && pnpm run build:content"
    },
    "dependencies": {
        "@octoclock/core": "workspace:*",
        "preact": "^10.19.3"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.5.0",
        "@tailwindcss/vite": "^4.1.6",
        "@types/chrome": "^0.1.37",
        "tailwindcss": "^4.1.6",
        "vite": "^6.3.5",
        "vite-plugin-css-injected-by-js": "^3.5.2",
        "vite-plugin-static-copy": "^2.3.1"
    }
}