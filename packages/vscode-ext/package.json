{
    "name": "octoclock",
    "displayName": "GitHub Time Tracker",
    "publisher": "zestones",
    "description": "Track time spent on GitHub issues",
    "version": "1.0.3",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "octoclock",
                    "title": "OctoClock",
                    "icon": "./src/icons/octoclock.svg"
                }
            ]
        },
        "views": {
            "octoclock": [
                {
                    "type": "webview",
                    "id": "octoclock.activeTimer",
                    "name": "Active Timer"
                },
                {
                    "type": "webview",
                    "id": "octoclock.myIssues",
                    "name": "My Issues"
                },
                {
                    "type": "webview",
                    "id": "octoclock.trackedTime",
                    "name": "Tracked Time"
                },
                {
                    "type": "webview",
                    "id": "octoclock.teamStats",
                    "name": "Team Stats"
                },
                {
                    "type": "webview",
                    "id": "octoclock.settings",
                    "name": "Settings"
                }
            ],
            "explorer": [
                {
                    "id": "octoclock.repoTree",
                    "name": "OctoClock"
                }
            ]
        },
        "commands": [
            {
                "command": "octoclock.startTimer",
                "title": "Start timer for issue",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.stopTimer",
                "title": "Stop current timer",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.syncNow",
                "title": "Sync tracker comments now",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.deleteSession",
                "title": "Delete session",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.editSession",
                "title": "Edit session duration",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.pinRepo",
                "title": "Pin repository",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.unpinRepo",
                "title": "Unpin repository",
                "category": "OctoClock"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "octoclock.pinRepo",
                    "when": "view == octoclock.repoTree",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "octoclock.unpinRepo",
                    "when": "viewItem == octoclock.repo",
                    "group": "octoclock@1"
                },
                {
                    "command": "octoclock.deleteSession",
                    "when": "viewItem == octoclock.session",
                    "group": "octoclock@1"
                },
                {
                    "command": "octoclock.editSession",
                    "when": "viewItem == octoclock.session",
                    "group": "octoclock@2"
                }
            ]
        }
    },
    "scripts": {
        "test:e2e": "node e2e/run-tests.mjs"
    },
    "dependencies": {
        "@octoclock/core": "workspace:*"
    },
    "devDependencies": {
        "@vscode/test-cli": "0.0.12",
        "@vscode/test-electron": "2.5.2"
    }
}