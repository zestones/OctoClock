{
    "name": "octoclock",
    "displayName": "OctoClock — GitHub Time Tracker",
    "publisher": "zestones",
    "description": "Track time spent on GitHub issues directly from VS Code. Start and stop timers per issue, sync sessions back to a tracker comment, and review where your time goes with team-aware dashboards.",
    "version": "1.0.3",
    "private": true,
    "license": "MIT",
    "categories": [
        "Other",
        "SCM Providers",
        "Visualization"
    ],
    "keywords": [
        "github",
        "time tracking",
        "timer",
        "issues",
        "productivity",
        "dashboard"
    ],
    "icon": "src/icons/octoclock.svg",
    "repository": {
        "type": "git",
        "url": "https://github.com/zestones/OctoClock.git"
    },
    "bugs": {
        "url": "https://github.com/zestones/OctoClock/issues"
    },
    "homepage": "https://github.com/zestones/OctoClock#readme",
    "engines": {
        "vscode": "^1.85.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "OctoClock",
            "properties": {
                "octoclock.idleReminderEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a reminder when no editor activity has been detected for a while and a timer is running."
                },
                "octoclock.idleReminderMinutes": {
                    "type": "number",
                    "default": 30,
                    "minimum": 1,
                    "maximum": 240,
                    "description": "Minutes of editor inactivity before the idle reminder is shown."
                },
                "octoclock.enableCodeLens": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show 'Track #N' CodeLenses on issue references in source files."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "octoclock",
                    "title": "OctoClock",
                    "icon": "./src/icons/octoclock.svg"
                }
            ]
        },
        "views": {
            "octoclock": [
                {
                    "type": "webview",
                    "id": "octoclock.activeTimer",
                    "name": "Active Timer"
                },
                {
                    "type": "webview",
                    "id": "octoclock.myIssues",
                    "name": "My Issues"
                },
                {
                    "id": "octoclock.trackedTime",
                    "name": "Tracked Time"
                },
                {
                    "type": "webview",
                    "id": "octoclock.teamStats",
                    "name": "Team Stats"
                },
                {
                    "id": "octoclock.settings",
                    "name": "Settings"
                }
            ]
        },
        "commands": [
            {
                "command": "octoclock.openActiveTimer",
                "title": "Open Active Timer",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.startTimer",
                "title": "Track this issue",
                "category": "OctoClock",
                "icon": "$(play)"
            },
            {
                "command": "octoclock.stopTimer",
                "title": "Stop current timer",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.syncNow",
                "title": "Sync tracker comments now",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.deleteSession",
                "title": "Delete session",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.editSession",
                "title": "Edit session duration",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.pinRepo",
                "title": "Pin repository",
                "category": "OctoClock",
                "icon": "$(pin)"
            },
            {
                "command": "octoclock.unpinRepo",
                "title": "Unpin repository",
                "category": "OctoClock",
                "icon": "$(pinned-dirty)"
            },
            {
                "command": "octoclock.refreshTrackedTime",
                "title": "Refresh tracked time",
                "category": "OctoClock",
                "icon": "$(refresh)"
            },
            {
                "command": "octoclock.toggleWorkspaceFilter",
                "title": "Toggle workspace filter",
                "category": "OctoClock",
                "icon": "$(filter)"
            },
            {
                "command": "octoclock.openDashboard",
                "title": "Open Dashboard",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.configureToken",
                "title": "Configure GitHub Token",
                "category": "OctoClock",
                "icon": "$(key)"
            },
            {
                "command": "octoclock.toggleAutoSync",
                "title": "Toggle Auto Sync",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.toggleIdleReminder",
                "title": "Toggle Idle Reminder",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.editIdleMinutes",
                "title": "Edit Idle Reminder Minutes",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.toggleCodeLens",
                "title": "Toggle Code Lens",
                "category": "OctoClock"
            },
            {
                "command": "octoclock.refreshSettings",
                "title": "Refresh Settings",
                "category": "OctoClock",
                "icon": "$(refresh)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "octoclock.pinRepo",
                    "when": "view == octoclock.trackedTime",
                    "group": "navigation@1"
                },
                {
                    "command": "octoclock.refreshTrackedTime",
                    "when": "view == octoclock.trackedTime",
                    "group": "navigation@2"
                },
                {
                    "command": "octoclock.toggleWorkspaceFilter",
                    "when": "view == octoclock.trackedTime",
                    "group": "navigation@3"
                },
                {
                    "command": "octoclock.configureToken",
                    "when": "view == octoclock.settings",
                    "group": "navigation@1"
                },
                {
                    "command": "octoclock.refreshSettings",
                    "when": "view == octoclock.settings",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "octoclock.unpinRepo",
                    "when": "viewItem == oc-repo",
                    "group": "octoclock@1"
                },
                {
                    "command": "octoclock.deleteSession",
                    "when": "viewItem == oc-session",
                    "group": "octoclock@1"
                },
                {
                    "command": "octoclock.editSession",
                    "when": "viewItem == oc-session",
                    "group": "octoclock@2"
                },
                {
                    "command": "octoclock.stopTimer",
                    "when": "viewItem == oc-issue-active",
                    "group": "inline"
                },
                {
                    "command": "octoclock.startTimer",
                    "when": "viewItem == oc-issue",
                    "group": "inline"
                }
            ]
        }
    },
    "scripts": {
        "test:e2e": "node e2e/run-tests.mjs"
    },
    "dependencies": {
        "@octoclock/core": "workspace:*"
    },
    "devDependencies": {
        "@vscode/test-cli": "0.0.12",
        "@vscode/test-electron": "2.5.2"
    }
}
